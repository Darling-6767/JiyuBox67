<Window x:Class="JiyuBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="极域工具箱 · JiyuBox" Height="620" Width="780"
        MinHeight="560" MinWidth="720"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="2,0,2,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="26" CornerRadius="2" Background="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                <StackPanel>
                    <TextBlock Text="极域工具箱" Foreground="{StaticResource TextBrush}"
                               FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="SubtitleText" Text="JiyuBox 0.1.0 · 只挂起不杀进程"
                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <Border x:Name="StatusPill" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="#1F2632" BorderBrush="#2E3849" BorderThickness="1"
                    CornerRadius="12" Padding="12,5">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource MutedBrush}"
                             VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock x:Name="StatusText" Text="正在探测…" FontSize="12"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 主体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 状态卡 -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="环境状态" Foreground="{StaticResource TextBrush}"
                               FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="适配档" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AdapterValue" Style="{StaticResource Value}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="进程" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ProcValue" Style="{StaticResource Value}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="版本" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="VersionValue" Style="{StaticResource Value}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="广播" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="BroadcastValue" Style="{StaticResource Value}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="黑屏" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="BlackValue" Style="{StaticResource Value}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="挂起" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="SuspendValue" Style="{StaticResource Value}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="键鼠锁" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="InputValue" Style="{StaticResource Value}" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" x:Name="DetailValue"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,10,0,0" VerticalAlignment="Top" />
                    </Grid>
                </Grid>
            </Border>

            <!-- 动作卡 -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="动作" Foreground="{StaticResource TextBrush}"
                               FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <StackPanel Grid.Row="1">
                        <Button x:Name="BtnWindowize" Style="{StaticResource PrimaryButton}" Click="OnWindowize"
                                Content="窗口化广播　Ctrl+Alt+W" />
                        <Button x:Name="BtnBlack" Style="{StaticResource ActionButton}" Click="OnExitBlack"
                                Content="退出黑屏安静　Ctrl+Alt+B" />
                        <Button x:Name="BtnInput" Style="{StaticResource ActionButton}" Click="OnToggleInput"
                                Content="解除键鼠锁" />
                        <Button x:Name="BtnSuspend" Style="{StaticResource ActionButton}" Click="OnToggleSuspend"
                                Content="挂起极域　Ctrl+Alt+P" />
                        <Separator Background="#2A3040" Margin="0,6,0,10" />
                        <Button x:Name="BtnRestore" Style="{StaticResource ActionButton}" Click="OnRestore"
                                Content="全部还原" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 日志 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="10,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="运行日志" Foreground="{StaticResource MutedBrush}"
                           FontSize="11" Margin="4,0,0,4" />
                <ListBox Grid.Row="1" x:Name="LogList" Height="132" Background="Transparent"
                         BorderThickness="0" Foreground="{StaticResource MutedBrush}"
                         FontFamily="Cascadia Mono, Consolas" FontSize="11"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="2,1" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="#A8B2C4" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- 底栏 -->
        <Grid Grid.Row="3" Margin="2,10,2,0">
            <TextBlock x:Name="ElevationText" Foreground="{StaticResource MutedBrush}" FontSize="11"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="LogPathText" Foreground="#5C667A" FontSize="10"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Content="打开日志目录" Click="OnOpenLogFolder" FontSize="11"
                        Padding="8,3" Background="#1F2632" Foreground="#A8B2C4"
                        BorderBrush="#2E3849" BorderThickness="1" Cursor="Hand" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
